<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper_white">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/ink_grey">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="装备模拟器"
            android:textColor="@color/gold"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="长按槽位可清除装备"
            android:textColor="@color/canghuang"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 6 Equipment Slots -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/canghuang">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView android:id="@+id/slot1" android:layout_width="0dp" android:layout_height="72dp"
                android:layout_weight="1" android:layout_margin="4dp"
                android:src="@drawable/ic_slot_empty" android:background="@drawable/slot_background"
                android:scaleType="centerInside" android:padding="8dp" />
            <ImageView android:id="@+id/slot2" android:layout_width="0dp" android:layout_height="72dp"
                android:layout_weight="1" android:layout_margin="4dp"
                android:src="@drawable/ic_slot_empty" android:background="@drawable/slot_background"
                android:scaleType="centerInside" android:padding="8dp" />
            <ImageView android:id="@+id/slot3" android:layout_width="0dp" android:layout_height="72dp"
                android:layout_weight="1" android:layout_margin="4dp"
                android:src="@drawable/ic_slot_empty" android:background="@drawable/slot_background"
                android:scaleType="centerInside" android:padding="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView android:id="@+id/slot4" android:layout_width="0dp" android:layout_height="72dp"
                android:layout_weight="1" android:layout_margin="4dp"
                android:src="@drawable/ic_slot_empty" android:background="@drawable/slot_background"
                android:scaleType="centerInside" android:padding="8dp" />
            <ImageView android:id="@+id/slot5" android:layout_width="0dp" android:layout_height="72dp"
                android:layout_weight="1" android:layout_margin="4dp"
                android:src="@drawable/ic_slot_empty" android:background="@drawable/slot_background"
                android:scaleType="centerInside" android:padding="8dp" />
            <ImageView android:id="@+id/slot6" android:layout_width="0dp" android:layout_height="72dp"
                android:layout_weight="1" android:layout_margin="4dp"
                android:src="@drawable/ic_slot_empty" android:background="@drawable/slot_background"
                android:scaleType="centerInside" android:padding="8dp" />
        </LinearLayout>

        <!-- Stats -->
        <TextView
            android:id="@+id/tv_total_gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="总费用：0金币"
            android:textColor="@color/ink_grey"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:paddingStart="4dp" />

        <TextView
            android:id="@+id/tv_stats_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="尚未选择装备"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:paddingStart="4dp" />
    </LinearLayout>

    <!-- Items title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择装备"
        android:textColor="@color/ink_grey"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:padding="12dp" />

    <!-- Items grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3" />

</LinearLayout>
