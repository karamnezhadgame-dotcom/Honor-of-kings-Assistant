<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canghuang"
    android:padding="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/tv_lore_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="长安城" android:textColor="@color/ink_grey" android:textSize="28sp" android:textStyle="bold" android:fontFamily="serif" android:gravity="center" />
        <TextView android:id="@+id/tv_lore_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="故事内容..." android:textColor="@color/text_primary" android:textSize="16sp" android:lineSpacingExtra="8sp" android:fontFamily="serif" android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
